{
	"name": "para-ios",
	"version": "0.1.0",
	"description": "Para — App-runtime GUI agent for iOS, rebuilt as a pi extension. Drives a running iOS app in natural language and builds a knowledge graph as it explores.",
	"type": "module",
	"private": true,
	"main": "./src/index.ts",
	"bin": {
		"para": "./src/cli.ts"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "bun test",
		"para": "bun src/cli.ts",
		"pi": "pi -e ./src/index.ts"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^0.84.4",
		"@earendil-works/pi-agent-core": "^0.84.4",
		"@earendil-works/pi-ai": "^0.84.4",
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5.6.0"
	}
}
